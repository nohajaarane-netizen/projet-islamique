generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  avatarUrl     String
  preferredLang String   @default("fr")
  locationLat   Float?
  locationLon   Float?
  cityName      String   @default("Berrechid, Maroc")
  timezone      String   @default("Africa/Casablanca")
  darkMode      Boolean  @default(false)
  fontSize      Int      @default(16)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prayerTrackings      PrayerTracking[]
  gratitudeEntries     GratitudeEntry[]
  nameProgress         UserNameProgress[]
  favorites            Favorite[]
  notificationSettings NotificationSetting[]
  streaks              UserStreak[]
  badges               Badge[]
  dhikrEntries         DhikrEntry[]

  @@map("users")
}

model PrayerTime {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime
  fajr              DateTime
  chourouq          DateTime
  dhuhr             DateTime
  asr               DateTime
  maghrib           DateTime
  isha              DateTime
  hijriDate         String
  calculationMethod String   @default("MWL")
  createdAt         DateTime @default(now())

  @@unique([userId, date])
  @@map("prayer_times")
}

model PrayerTracking {
  id          String       @id @default(uuid())
  userId      String
  prayerType  String
  date        DateTime
  status      String @default("PENDING")
  completedAt DateTime?
  timestamp   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, prayerType, date])
  @@map("prayer_trackings")
}

model NameOfAllah {
  id              String  @id @default(uuid())
  orderNumber     Int     @unique
  arabic          String
  transliteration String
  frenchMeaning   String
  englishMeaning  String
  audioUrl        String?
  reflectionFr    String
  reflectionEn    String
  reflectionAr    String

  userProgress UserNameProgress[]
  favorites    Favorite[]

  @@map("names_of_allah")
}

model UserNameProgress {
  userId     String
  nameId     String
  isLearned  Boolean   @default(false)
  isFavorite Boolean   @default(false)
  learnedAt  DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name NameOfAllah @relation(fields: [nameId], references: [id], onDelete: Cascade)

  @@id([userId, nameId])
  @@map("user_name_progress")
}

model Hadith {
  id                 String          @id @default(uuid())
  arabicText         String
  frenchTranslation  String
  englishTranslation String
  transliteration    String?
  sourceBook         String
  sourceNumber       String
  category           String @default("DAILY")
  audioUrl           String?
  isDailyFeatured    Boolean         @default(false)
  featuredDate       DateTime?
  createdAt          DateTime        @default(now())

  favorites Favorite[]

  @@map("hadiths")
}

model Dua {
  id                 String          @id @default(uuid())
  arabicText         String
  frenchTranslation  String
  englishTranslation String
  transliteration    String?
  category           String @default("DAILY")
  occasion           String?
  audioUrl           String?
  isDailyFeatured    Boolean         @default(false)
  featuredDate       DateTime?
  createdAt          DateTime        @default(now())

  favorites Favorite[]

  @@map("duas")
}

model GratitudeEntry {
  id        String            @id @default(uuid())
  userId    String
  text      String
  category  String @default("ALLAH")
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gratitude_entries")
}

model DhikrEntry {
  id        String    @id @default(uuid())
  userId    String
  type      String
  count     Int       @default(0)
  date      DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, date])
  @@map("dhikr_entries")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  hadithId  String?
  duaId     String?
  nameId    String?
  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hadith Hadith?      @relation(fields: [hadithId], references: [id], onDelete: Cascade)
  dua    Dua?         @relation(fields: [duaId], references: [id], onDelete: Cascade)
  name   NameOfAllah? @relation(fields: [nameId], references: [id], onDelete: Cascade)

  @@unique([userId, hadithId])
  @@unique([userId, duaId])
  @@unique([userId, nameId])
  @@map("favorites")
}

model UserStreak {
  id               String     @id @default(uuid())
  userId           String
  streakType       String @default("PRAYER")
  currentStreak    Int        @default(0)
  bestRecord       Int        @default(0)
  lastActivityDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakType])
  @@map("user_streaks")
}

model Badge {
  id        String    @id @default(uuid())
  userId    String
  badgeType String
  earnedAt  DateTime  @default(now())
  criteria  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@map("badges")
}

model NotificationSetting {
  id            String     @id @default(uuid())
  userId        String
  prayerType    String
  isEnabled     Boolean    @default(true)
  minutesBefore Int        @default(15)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, prayerType])
  @@map("notification_settings")
}

model DailyContent {
  id        String   @id @default(uuid())
  date      DateTime @unique
  hadithId  String?
  duaId     String?
  nameId    String?
  createdAt DateTime @default(now())

  @@map("daily_contents")
}















